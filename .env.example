# ==============================================================================
# AGENT MEMORY PLATFORM — ENVIRONMENT
# ==============================================================================
# First deployment on a trusted LAN address:
#   make env-init LXC_HOST_IP=10.10.20.18
#
# `make env-init` generates MEMORY_API_TOKEN and MEMORY_POSTGRES_PASSWORD when
# they are still GENERATE_ME, and refuses to overwrite an existing .env.
#
# Keep this file committed with placeholders only. `.env` and its backups are
# local operator records and must never be committed.
# ==============================================================================

# ------------------------------------------------------------------------------
# NETWORK AND API
# ------------------------------------------------------------------------------
# Bind only to one trusted private or loopback IP. The default remains loopback
# so a generic first run cannot accidentally expose the API to the LAN.
MEMORY_API_BIND_ADDRESS=127.0.0.1

# Host port published by Docker. Container port 8000 remains internal and fixed.
# Port 8200 is unused in the documented 10.10.20.18 socket inventory
# (8080 document-processing-platform, 8100 runtime framework, 3100/9190 langfuse).
MEMORY_API_PORT=8200

# ------------------------------------------------------------------------------
# AUTHENTICATION
# ------------------------------------------------------------------------------
# Bearer token required on every route except /health and /ready.
MEMORY_API_TOKEN=GENERATE_ME

# ------------------------------------------------------------------------------
# POSTGRES + PGVECTOR
# ------------------------------------------------------------------------------
# Postgres is never published to the host or the LAN; only the api service
# reaches it, over the internal Compose network.
MEMORY_POSTGRES_USER=memory_platform
MEMORY_POSTGRES_PASSWORD=GENERATE_ME
MEMORY_POSTGRES_DB=memory_platform

# ------------------------------------------------------------------------------
# EMBEDDINGS
# ------------------------------------------------------------------------------
# `deterministic` requires no network access or API key and is safe for local
# development, CI, and tests. It is not a real semantic embedding.
# `openai` calls the OpenAI embeddings API and requires OPENAI_API_KEY.
MEMORY_EMBEDDING_PROVIDER=deterministic
MEMORY_EMBEDDING_MODEL=text-embedding-3-small
MEMORY_EMBEDDING_DIMENSIONS=1536
OPENAI_API_KEY=

# ------------------------------------------------------------------------------
# APPLICATION
# ------------------------------------------------------------------------------
MEMORY_APP_LOG_LEVEL=INFO
MEMORY_CORS_ORIGINS=

# ------------------------------------------------------------------------------
# DIGEST-PINNED SERVICE IMAGES
# ------------------------------------------------------------------------------
# Image updates require a reviewed change to both the digest and this comment.
MEMORY_POSTGRES_IMAGE=pgvector/pgvector:pg16@sha256:a36250871de0833b8757561c72f2477ef1ddd1101afa4e617fb552e0de514c6b
